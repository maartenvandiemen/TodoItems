// Dev container for TodoItems.
//
// Open it with "Dev Containers: Clone Repository in Container Volume..." (Command Palette, F1),
// NOT with "Reopen in Container" on a folder on your C: drive.
//  - Clone in Volume: git clones into a Docker volume, a Linux (case-sensitive) filesystem.
//    Casing bugs, CRLF in shell scripts and other Linux-only problems show up here, on your machine.
//  - Reopen in Container on C:\...: the folder is bind-mounted from Windows, so file lookups stay
//    case-insensitive and git on Windows can still merge Folder/ and folder/. check-case-sensitivity.sh
//    warns you when that happens.
{
  "name": "TodoItems",

  // The same SDK image the CI build uses (build.Dockerfile), so "works in the dev container" means
  // "works in CI". global.json pins 11.0.100 (latestPatch).
  "image": "mcr.microsoft.com/dotnet/sdk:11.0",

  // Based on Microsoft's Aspire dev container (github.com/microsoft/aspire-devcontainer), without
  // Node, Python, uv and PowerShell: the AppHost only runs .NET projects and SQL Server.
  "features": {
    // The 'aspire' CLI: 'aspire run', 'aspire certs trust', and the MCP server in .mcp.json.
    "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:2": {},
    // Non-root 'vscode' user, git, and the usual shell tools on top of the plain SDK image.
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false
    },
    // Docker inside the dev container, for Testcontainers (integration tests start SQL Server)
    // and for Aspire (the AppHost starts SQL Server). Docker-in-docker instead of the host socket:
    // containers started by the tests are reachable on localhost, and bind mounts resolve inside
    // the dev container. The feature keeps /var/lib/docker in a volume, so pulled images survive a rebuild.
    // moby: false installs Docker CE instead of Moby: the SDK 11.0 image is Ubuntu 26.04 (resolute),
    // and Microsoft does not publish Moby packages for it (yet).
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    // Claude Code, so it works on the case-sensitive clone in the volume. It needs Node.js and npm;
    // Ubuntu 26.04's own nodejs package comes without npm, so install Node.js through its feature.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // main.bicep is linted in the pipeline.
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    }
  },

  "remoteUser": "vscode",

  // Claude Code login and settings survive a rebuild. One volume per dev container (${devcontainerId}),
  // so another repo's dev container cannot mount it and read the login token.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  "containerEnv": {
    "DOTNET_NOLOGO": "true",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
    // Aspire dashboard without a login token, so the forwarded port (15278) opens directly.
    // Dev container only: the port is only forwarded to localhost on your own machine.
    "ASPIRE_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS": "true"
  },

  // The Claude Code volume is created as root: give it to the 'vscode' user first.
  // Then the same restore as CI: --locked-mode fails when packages.lock.json is out of date.
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && dotnet restore TodoItems.slnx --locked-mode && dotnet tool restore --tool-manifest TodoItems.Api/.config/dotnet-tools.json",

  // .NET and OpenSSL inside the container trust the ASP.NET Core development certificate
  // (Aspire dashboard and resources over HTTPS). Same as Microsoft's Aspire dev container.
  "remoteEnv": {
    "SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/vscode/.aspnet/dev-certs/trust"
  },

  // Runs on every start:
  //  - certs: create and trust the HTTPS development certificate;
  //  - case: warn when the workspace is not on a case-sensitive filesystem.
  "postStartCommand": {
    "certs": "aspire certs trust --non-interactive",
    "case": "bash .devcontainer/check-case-sensitivity.sh"
  },

  // Aspire dashboard (TodoItems.AppHost/Properties/launchSettings.json). The API's ports are
  // assigned by Aspire and forwarded automatically when they open.
  "forwardPorts": [15278],
  "portsAttributes": {
    "15278": { "label": "Aspire dashboard", "onAutoForward": "openBrowser" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "microsoft-aspire.aspire-vscode",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-bicep"
      ]
    }
  }
}
